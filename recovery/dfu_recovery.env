bootargs=modules=loop,g_ether ip=172.16.42.2::172.16.42.1:255.255.255.0::usb0:::8.8.8.8:: dropbear=yes single
fdt_addr_r=0x01000000
kernel_addr_r=0x01080000
ramdisk_addr_r=0x10000000
bootcmd_usbdfu=if test "${boot_source}" = "usb"; then dfu 0 ram 0 60;bootm 0x08080000;booti 0x01080000 0x10000000:0x4000000 0x01000000;fi
dfu_alt_info=kernel ram 0x01080000 0x4000000;dtb ram 0x01000000 0x80000;initrd ram 0x10000000 0x4000000;fitimage ram 0x08080000 0x4000000