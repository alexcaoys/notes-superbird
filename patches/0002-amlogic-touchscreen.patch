+static int tlsc6x_set_dd_mode(void)
+{
+	int ret = 0;
+ //       TLSC_FUNC_ENTER();
+	mutex_lock(&i2c_rw_access);
+	ret = tlsc6x_set_dd_mode_nolock();
+	mutex_unlock(&i2c_rw_access);
+	return ret;
+}
