+static enum hrtimer_restart tpd_esd_kthread_hrtimer_func(struct hrtimer *timer)
+{
+    tpd_esd_flag = 1;
+    wake_up_interruptible(&tpd_esd_waiter);
+
+    return HRTIMER_NORESTART;
+}
