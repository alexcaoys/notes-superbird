+/* 0:successful */
+static int tlsc6x_set_nor_mode_nolock(void)
+{
+	int mod = -1;
+	int retry = 0;
+	u8 reg = 0x05;
+  //      TLSC_FUNC_ENTER();
+	while (retry++ < 5) {
+		tlsc6x_write_bytes_u16addr_nolock(g_tlsc6x_client, 0x03, &reg, 1);
+		usleep_range(5000, 5500);
+		mod = tlsc6x_get_i2cmode();
+		if (mod == DEDICATE_MODE) {
+			break;
+		}
+		msleep(50);
+	}
+	if (mod == DEDICATE_MODE) {
+		return 0;
+	} else {
+		return -EPERM;
+	}
+}
