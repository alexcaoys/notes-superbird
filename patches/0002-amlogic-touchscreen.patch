+int tlsc6x_auto_upgrade_buidin(void)
+{
+	u8 *fupd = fw_file_tlsc6x;
+	TLSC_FUNC_ENTER();
+	return tlsc6x_update_compat_ctl((u8 *) fupd, fw_size, 0);
+}
