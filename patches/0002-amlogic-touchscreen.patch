+/* <0 : i2c error */
+/* 0: direct address mode */
+/* 1: protect mode */
+static int tlsc6x_get_i2cmode(void)
+{
+    u8 regData[4];
+    TLSC_FUNC_ENTER();
+	if (tlsc6x_read_bytes_u16addr_nolock(g_tlsc6x_client, 0x01, regData, 3)) {
+		return -EPERM;
+	}
+
+	if (((u8) (g_tlsc6x_client->addr) == (regData[0] >> 1)) && (regData[2] == 0X01)) {
+		return DIRECTLY_MODE;
+	}
+
+    return DEDICATE_MODE;
+}
+
+/* 0:successful */
+static int tlsc6x_set_dd_mode_nolock(void)
+{
+	int mod = -1;
+	int retry = 0;
+
+	int ret = 0;
+
+	ret = tlsc6x_get_i2cmode();
+//         TLSC_FUNC_ENTER();
+	if (ret < 0) {
+		return ret;
+	}
+
+	if (ret == DIRECTLY_MODE) {
+		return 0;
+	}
+
+	while (retry++ < 5) {
+		msleep(20);
+		tlsc6x_write_bytes_u16addr_nolock(g_tlsc6x_client, 0x42bd, cmd_2dma_42bd, 6);
+		msleep(30);
+		mod = tlsc6x_get_i2cmode();
+		if (mod == DIRECTLY_MODE) {
+			break;
+		}
+	}
+
+	if (mod == DIRECTLY_MODE) {
+		return 0;
+	} else {
+		return -EPERM;
+	}
+}
