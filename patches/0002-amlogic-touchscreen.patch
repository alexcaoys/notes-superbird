+static void tlsc6x_do_update_ifneed(void)
+{
+	u8 *fupd = fw_file_tlsc6x;
+	TLSC_FUNC_ENTER();
+	tlsc6x_update_compat_ctl((u8 *) fupd, fw_size, 0);
+}
